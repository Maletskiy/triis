{
  "name": "iis-calc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "esbuild scripts/check.ts --bundle --platform=node --format=esm --outfile=scripts/check.mjs --log-level=error && node scripts/check.mjs",
    "ui-check": "vite preview --port 4173 --strictPort & sleep 2 && node scripts/ui-check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "puppeteer-core": "^25.15.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
